  "repository": {
    "type": "git",
    "url": "git+https://github.com/PermitStack/permitstack-mcp.git"
  },
  "homepage": "https://permit-stack.com",
  "bugs": {
    "url": "https://github.com/PermitStack/permitstack-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
